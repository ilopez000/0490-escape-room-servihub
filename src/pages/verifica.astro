---
import Base from '../layouts/Base.astro';
import { CHECKLIST, SALES } from '../data/joc';
---
<Base titol="Verifica un informe" hud={false}>
  <section class="verificador">
    <p class="sobretitol">Eina del professor</p>
    <h1>Verifica un informe</h1>
    <p class="intro-mapa">
      Enganxa aquí el text del correu (o només la línia «Segell: …»). L'eina descodifica el segell i comprova que
      les xifres coincideixen amb les que va generar el joc.
    </p>
    <textarea id="entrada" rows="7" placeholder="Segell: eyJ…"></textarea>
    <div class="centre esquerra"><button class="boto boto-principal" id="comprova" type="button">Comprova</button></div>
    <div id="resultat" class="resultat-verificacio" hidden></div>
  </section>

  <script type="application/json" id="noms-plantes" set:html={JSON.stringify(SALES.map((s) => `${s.id} · ${s.nom}`))} />
  <script type="application/json" id="checklist" set:html={JSON.stringify(CHECKLIST)} />

  <script>
    import { ASSOLIMENTS } from '../scripts/assoliments';
    import { dataLlegible, verifica } from '../scripts/informe';

    const plantes = JSON.parse(document.getElementById('noms-plantes')!.textContent!) as string[];
    const checklist = JSON.parse(document.getElementById('checklist')!.textContent!) as string[];
    const resultat = document.getElementById('resultat')!;

    function fila(etiqueta: string, valor: string): HTMLTableRowElement {
      const tr = document.createElement('tr');
      const th = document.createElement('th');
      th.textContent = etiqueta;
      const td = document.createElement('td');
      td.textContent = valor;
      tr.append(th, td);
      return tr;
    }

    document.getElementById('comprova')!.addEventListener('click', () => {
      const v = verifica((document.getElementById('entrada') as HTMLTextAreaElement).value);
      resultat.hidden = false;
      resultat.innerHTML = '';
      const cap = document.createElement('p');
      cap.className = v.valid ? 'veredicte ok' : 'veredicte ko';
      cap.textContent = v.valid
        ? '✔ Segell vàlid: les dades no s\'han modificat.'
        : v.error ?? '✖ El segell no quadra: el text s\'ha modificat a mà.';
      resultat.append(cap);
      if (!v.dades) return;
      const d = v.dades;
      const taula = document.createElement('table');
      taula.className = 'taula-nodes';
      taula.append(
        fila('Alumne/a', d.nom),
        fila('Àlies', d.alies || '—'),
        fila('Data', dataLlegible(d.data)),
        fila('Rendiment', `${d.percent}% (${d.base} XP de base + ${d.bonus} de bonus)`),
        fila('Vida final', `${d.vida}%`),
        fila('Errors · pistes', `${d.errors} · ${d.pistes}`),
        fila('Millor ratxa', String(d.millorRatxa)),
        ...d.plantes.map((p, i) => fila(`Nucli ${plantes[i] ?? i + 1}`, `${p[0]} XP · ${p[1]} errors · ${p[2]} pistes`)),
        fila('Kernel · boss', `${d.boss[0]} XP · ${d.boss[1]} errors · ${d.boss[2]} pistes`),
        fila('Assoliments', d.assoliments.map((id) => ASSOLIMENTS.find((a) => a.id === id)?.nom ?? id).join(', ') || '—'),
        fila('Autoavaluació', `${d.checklist.length} de ${checklist.length} marcats`),
      );
      resultat.append(taula);
    });
  </script>
</Base>
